WOLT_PROFILE_DIR=./agent/chrome-profile
GLOVO_PROFILE_DIR=./agent/glovo-profile
PYSZNE_PROFILE_DIR=./agent/pyszne-profile
BROWSER_CHANNEL=chrome
WOLT_BROWSER_CHANNEL=chrome
WOLT_LOGIN_MODE=manual
WOLT_LOGIN_TIMEOUT_SECONDS=300
PYSZNE_LOGIN_MODE=manual
PYSZNE_LOGIN_TIMEOUT_SECONDS=300
ALLOW_PAY=false
ALLOW_3DS_SUBMIT=false
ALLOW_SAVE_CARD=false
CARD_RAIL=altitude
CARD_PAN=
CARD_EXP=
CARD_CVC=
CARD_NAME=
MAIL_SOURCE=stub
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=fulfillment-demo@mail.buena.ai
CARD_BILLING_ADDRESS_LINE=
CARD_BILLING_CITY=
CARD_BILLING_REGION=
CARD_BILLING_POSTAL_CODE=
CARD_BILLING_COUNTRY=PL
PROOF_FILE=
FULFILLMENT_NONCE=
ALTITUDE_PROFILE_DIR=./agent/altitude-profile
ALTITUDE_URL=https://app.altitude.xyz
ALTITUDE_EXTENSION_DIR=
ALTITUDE_BROWSER_EXECUTABLE=
ALTITUDE_SERVER_PORT=8787
ALTITUDE_SERVER_TOKEN=
ALTITUDE_MAX_CARD_USD=
# Member email selected in the create-card Cardholder dropdown.
ALTITUDE_CARDHOLDER_EMAIL=
# Card issue limit frequency: All time, 7 day, 30 day, or Per authorization.
ALTITUDE_CARD_LIMIT_FREQUENCY=Per authorization
# Leave unset for form-fill-and-cancel dry runs; set to 1 to mutate cards.
ALTITUDE_LIVE_CARD_OPS=
ANCHOR_PROVIDER_URL=http://127.0.0.1:8899
FULFILLMENT_ORACLE_WALLET=../.demo/fulfillment-oracle.json

# The default stub reads agent/out/otp.json placed there by a human.
# MAIL_SOURCE=agentmail polls only AGENTMAIL_INBOX and writes the minimal
# classified handoff to agent/out/otp.json. MAIL_SOURCE=nango fails closed.
