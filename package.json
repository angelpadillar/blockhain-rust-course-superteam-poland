{
  "name": "gift-campaign-poc",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "demo:surfpool": "ts-node scripts/demo.ts",
    "replay:devnet": "ts-node scripts/fulfillment-chain.ts replay-devnet",
    "fulfillment:chain": "ts-node scripts/fulfillment-chain.ts",
    "format": "prettier --write \"scripts/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"scripts/**/*.ts\" \"*.{json,md}\"",
    "demo:trust": "node agent/trust/demo/server.mjs",
    "test:trust": "node --test agent/trust/evidence.test.mjs agent/trust/demo/*.test.mjs",
    "demo:gifting": "node agent/trust/integrated/server.mjs",
    "test:gifting": "node --test agent/trust/integrated/encoding.test.mjs agent/trust/integrated/integration.test.mjs",
    "build:gifting:bridge": "cargo build --locked --example gifting_bridge",
    "demo:delio": "node agent/trust/delio/server.mjs",
    "test:delio": "node --test agent/trust/delio/*.test.mjs agent/trust/delio/sms/*.test.mjs agent/trust/delio/worker/*.test.mjs",
    "browser:job": "node agent/multilogin/scripts/job.mjs",
    "browser:batch": "node agent/multilogin/batch-runner.mjs",
    "browser:job:fake": "node agent/multilogin/job-runner.mjs --mode fake",
    "browser:profiles": "node agent/multilogin/scripts/profiles.mjs",
    "test:browser:job": "node --test agent/multilogin/test/lifecycle.test.mjs agent/multilogin/test/orchestrator.test.mjs agent/multilogin/test/orchestrator.e2e.mjs agent/multilogin/test/screenshot-bundle.test.mjs agent/multilogin/test/recovery-memory.test.mjs agent/multilogin/test/action-router.test.mjs agent/multilogin/test/dialog-containment.test.mjs agent/multilogin/test/discord-notifier.test.mjs agent/multilogin/test/profile-health.test.mjs agent/multilogin/test/profile-labels.test.mjs agent/multilogin/test/bandwidth.test.mjs",
    "test:browser:multilogin": "npm --prefix agent/multilogin test",
    "test:browser:multilogin:live": "npm --prefix agent/multilogin run test:browser",
    "browser:bench": "node agent/jev/bench/cli.mjs",
    "browser:bench:report": "node agent/jev/bench/cli.mjs --report",
    "test:browser:bench": "node --test agent/jev/bench/*.test.mjs",
    "test:browser:kernel": "node --test agent/jev/tests/kernel-v6.test.mjs",
    "browser:flywheel:build": "node agent/jev/evals/browser-routing/cli/build.mjs",
    "browser:valen-readiness": "node agent/jev/evals/browser-routing/cli/readiness.mjs",
    "browser:valen-shadow": "node agent/jev/evals/browser-routing/cli/shadow.mjs",
    "test:browser:flywheel": "node --test agent/jev/evals/browser-routing/test/*.test.mjs",
    "codegen:will-escrow": "npm --prefix clients/will-escrow-ts run codegen",
    "test:will-escrow-client": "npm --prefix clients/will-escrow-ts test"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
